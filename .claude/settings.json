      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent/src/cli.mjs\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
